# ============================================================
# IntelliWealth – AI Powered Portfolio Intelligence Platform
# Environment Configuration
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=intelliwealth
POSTGRES_PASSWORD=intelliwealth_secret_2026
POSTGRES_DB=intelliwealth_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://intelliwealth:intelliwealth_secret_2026@postgres:5432/intelliwealth_db

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300
REDIS_ANALYTICS_TTL=600

# ---- JWT Authentication ----
JWT_SECRET_KEY=change-me-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Portfolio Service ----
PORTFOLIO_SERVICE_HOST=0.0.0.0
PORTFOLIO_SERVICE_PORT=8000
PORTFOLIO_SERVICE_LOG_LEVEL=info
PORTFOLIO_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Market Intelligence Service ----
MARKET_SERVICE_HOST=0.0.0.0
MARKET_SERVICE_PORT=8001
MARKET_SERVICE_LOG_LEVEL=info
MARKET_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ---- AI Insight Service ----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8002
AI_SERVICE_LOG_LEVEL=info
AI_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LLM Provider ----
LLM_PROVIDER=mock
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# ---- AWS Bedrock (set when LLM_PROVIDER=bedrock) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=IntelliWealth

# ---- Environment ----
ENVIRONMENT=development
DEBUG=true
