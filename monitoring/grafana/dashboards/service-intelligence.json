{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "AI Requests Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ai_requests_total[5m])) by (endpoint)",
          "legendFormat": "{{ endpoint }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "AI Response Time (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ai_response_duration_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "p50 {{ provider }}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_response_duration_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "p95 {{ provider }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Tokens Used (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_tokens_total[5m])) by (provider, model)",
          "legendFormat": "{{ provider }} / {{ model }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "AI Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_errors_total[5m])) by (endpoint) / sum(rate(ai_requests_total[5m])) by (endpoint) * 100",
          "legendFormat": "{{ endpoint }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] }
        }
      }
    },
    {
      "title": "Total AI Requests (cumulative)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(ai_requests_total)", "legendFormat": "Total Requests" }
      ]
    },
    {
      "title": "Total Tokens Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 16 },
      "targets": [
        { "expr": "sum(ai_tokens_total)", "legendFormat": "Total Tokens" }
      ]
    },
    {
      "title": "Total AI Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "expr": "sum(ai_errors_total)", "legendFormat": "Total Errors" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "title": "Portfolio Operations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(portfolio_operations_total[5m])) by (operation)",
          "legendFormat": "{{ operation }}"
        }
      ]
    },
    {
      "title": "Risk Assessments by Level",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum(risk_assessments_total) by (risk_level)",
          "legendFormat": "{{ risk_level }}"
        }
      ]
    },
    {
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sum(rate(cache_operations_total{result=\"hit\"}[5m])) / sum(rate(cache_operations_total[5m])) * 100",
          "legendFormat": "Hit Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] }
        }
      }
    },
    {
      "title": "Market Data Queries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "sum(rate(market_queries_total[5m])) by (query_type)",
          "legendFormat": "{{ query_type }}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["intelliwealth", "services", "ai"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "title": "IntelliWealth – Service Intelligence",
  "uid": "intelliwealth-services"
}
